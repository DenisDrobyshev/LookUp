<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>LookUp</AssemblyName>
    <RootNamespace>LookUp</RootNamespace>
    <Product>LookUp</Product>
    <Company>DenisDrobyshev</Company>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <Description>Grab any text on your screen. Select a region, get the recognized text in your clipboard.</Description>

    <ApplicationIcon>..\..\assets\lookup.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Faster startup / smaller footprint knobs for a tray utility -->
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\lookup.ico">
      <LogicalName>LookUp.lookup.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
