# Normalize line endings: LF in the repo, checked out native on each OS.
* text=auto

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.manifest  text eol=lf
*.sln       text eol=crlf

# Binary assets
*.ico       binary
*.png       binary
